#!/bin/bash
#SBATCH --job-name=cobre-mpi
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=100
#SBATCH --exclusive
#SBATCH --output=cobre_%j.out
#SBATCH --error=cobre_%j.err
#SBATCH --partition=cobre-pee
#SBATCH --time=0-23:00:00

# Usage: sbatch --nodes=N --constraint=TYPE cobre.job CASE_PATH COBRE_EXEC_VERSION
# Normally submitted through exec_cobre, which supplies --nodes / --constraint.

set -euo pipefail

COBRE_ROOT="${COBRE_ROOT:-/home/USER/pee}"
COBRE_BIN_DIR="${COBRE_BIN_DIR:-$COBRE_ROOT/bin}"
COBRE_VENV="${COBRE_VENV:-$COBRE_ROOT/venv}"
MPI_HOME="${MPI_HOME:-$HOME/mpich-4.2.3-pmix5}"

die() {
    echo "error: $*" >&2
    exit 1
}

[[ -n "${SLURM_JOB_ID:-}" ]] || die "submit this script with exec_cobre or sbatch, do not run it directly"
[[ $# -ge 1 && $# -le 2 ]] || die "usage: cobre.job CASE_PATH [COBRE_EXEC_VERSION]"

CASE_PATH="$1"
COBRE_EXEC_VERSION="${2:-${COBRE_EXEC_VERSION:-}}"
[[ -n "$COBRE_EXEC_VERSION" ]] || die "COBRE_EXEC_VERSION not given"

COBRE_EXE="$COBRE_BIN_DIR/cobre-mpi-$COBRE_EXEC_VERSION"
[[ -x "$COBRE_EXE" ]] || die "'$COBRE_EXE' not found or not executable"
[[ -d "$CASE_PATH" ]] || die "case directory '$CASE_PATH' does not exist"

export LD_LIBRARY_PATH="$MPI_HOME/lib:/opt/pmix/lib:${LD_LIBRARY_PATH:-}"
export PATH="$MPI_HOME/bin:$PATH"

echo "job:        $SLURM_JOB_ID ($SLURM_JOB_NAME)"
echo "nodes:      $SLURM_JOB_NUM_NODES [$SLURM_JOB_NODELIST]"
echo "ranks:      $SLURM_NTASKS x $SLURM_CPUS_PER_TASK threads"
echo "case:       $CASE_PATH"
echo "cobre:      $COBRE_EXE"
echo "started:    $(date --iso-8601=seconds)"

srun --mpi=pmix "$COBRE_EXE" run "$CASE_PATH" --threads "$SLURM_CPUS_PER_TASK"

echo "cobre done: $(date --iso-8601=seconds)"

"$COBRE_VENV/bin/cobre-bridge" dashboard "$CASE_PATH"
